{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/login",
      "destination": "/api/index.py"
    },
    {
      "source": "/test-db",
      "destination": "/api/index.py"
    },
    {
      "source": "/test-entra",
      "destination": "/api/index.py"
    },
    {
      "source": "/test-powerbi",
      "destination": "/api/index.py"
    },
    {
      "source": "/generate-embed-token",
      "destination": "/api/index.py"
    },
    {
      "source": "/get-kpi-dataset",
      "destination": "/api/index.py"
    },
    {
      "source": "/report-pages/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/embed-token/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ]
}
